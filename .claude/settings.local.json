{
  "permissions": {
    "allow": [
      "Bash(py:*)",
      "Bash(py -m pip install:*)",
      "Bash(py -c \"import sys; open\\(''.graphify_python'', ''w''\\).write\\(sys.executable\\)\")",
      "Bash(npx turbo typecheck)",
      "Bash(npx expo install:*)",
      "Bash(npm install:*)",
      "Bash(npm --version:*)",
      "Bash(node -e:*)",
      "Bash(node --disable-warning=ExperimentalWarning -e:*)",
      "Bash(node --version:*)",
      "Bash(node --input-type=commonjs:*)",
      "WebFetch(domain:github.com)",
      "Bash(npx claude-mem install:*)",
      "PowerShell(node --version; npx claude-mem install)",
      "PowerShell(npx claude-mem start)",
      "PowerShell(Invoke-WebRequest -UseBasicParsing http://localhost:37777/health | Select-Object -ExpandProperty Content)",
      "PowerShell(npm run *)",
      "PowerShell(npx turbo test 2>&1 | Select-Object -Last 40)",
      "PowerShell(npm test *)",
      "PowerShell(foreach \\($w in 'packages/chess','packages/poker','packages/shared','packages/ai-brain'\\) { Write-Output \"=== $w ===\"; npm test -w $w 2>&1 | Select-String -Pattern 'Tests:|Test Suites:|failed|FAIL' | Select-Object -First 4 })"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "claude-mem",
    "perplexity",
    "firecrawl",
    "glif"
  ]
}

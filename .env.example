# Server
PORT=3001
# Required in production. Set to your frontend URL (e.g. https://checkker.com).
# Without this, all cross-origin requests are blocked.
CORS_ORIGIN=
# Required in production. Admin API key for /admin/* endpoints.
ADMIN_API_KEY=

# Crash reporting — Sentry (recommended for production)
# Create a project at https://sentry.io → copy the DSN here.
# Without this, errors are logged to console only.
SENTRY_DSN=

# Database (optional — enables persistent profiles)
DATABASE_URL=postgresql://user:password@localhost:5432/checkker

# Blockchain — BSC (optional — enables crypto betting)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
# WebSocket RPC (optional, preferred for reliable real-time event detection).
# Falls back to HTTP polling if not set. Get a WebSocket endpoint from your
# RPC provider (e.g., wss://bsc-testnet-rpc.publicnode.com).
BSC_WS_URL=
BSC_CHAIN_ID=97
CHECKKER_CONTRACT_ADDRESS=0x...
REFEREE_PRIVATE_KEY=0x...
HOUSE_WALLET_ADDRESS=0x...

# ── Client wallet / connectivity ────────────────────────────────────────
# Expo (apps/mobile, also used by the web build bundled into the desktop .exe)
# Server address clients connect to. On the web build this is auto-derived from
# the page origin; set it explicitly to point at another machine's [ip]:port.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.20:3001
# Sentry DSN for the React Native / web client.
EXPO_PUBLIC_SENTRY_DSN=
# WalletConnect v2 project id (https://cloud.reown.com) — enables Trust Wallet /
# MetaMask Mobile / any external wallet via QR. Without it only injected wallets
# (MetaMask extension, wallet in-app browsers) work.
EXPO_PUBLIC_WC_PROJECT_ID=

# Flutter (checkker_mobile) — pass at build/run time via --dart-define:
#   flutter run --dart-define=SERVER_URL=http://192.168.1.20:3001 \
#               --dart-define=CHECKKER_WC_PROJECT_ID=<id> \
#               --dart-define=SENTRY_DSN=<your-sentry-dsn>
# (The in-app Settings → Network screen can also override SERVER_URL at runtime.)

# AI (optional)
STOCKFISH_PATH=/usr/local/bin/stockfish
AI_COACH_PROVIDER=openai
AI_COACH_API_KEY=sk-...
AI_BRAIN_PERSISTENCE=true
AI_BRAIN_STORAGE=./data/player-models
SMART_MATCHMAKING=true

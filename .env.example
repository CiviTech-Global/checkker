# Server
PORT=3001

# Database (optional — enables persistent profiles)
DATABASE_URL=postgresql://user:password@localhost:5432/checkker

# Blockchain — BSC (optional — enables crypto betting)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=97
CHECKKER_CONTRACT_ADDRESS=0x...
REFEREE_PRIVATE_KEY=0x...
HOUSE_WALLET_ADDRESS=0x...

# AI (optional)
STOCKFISH_PATH=/usr/local/bin/stockfish
AI_COACH_PROVIDER=openai
AI_COACH_API_KEY=sk-...
AI_BRAIN_PERSISTENCE=true
AI_BRAIN_STORAGE=./data/player-models
SMART_MATCHMAKING=true

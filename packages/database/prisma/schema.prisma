generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  walletAddress String   @unique @map("wallet_address") @db.VarChar(42)
  username      String   @unique @db.VarChar(32)
  avatarId      String   @default("king_white") @map("avatar_id") @db.VarChar(32)
  rating        Int      @default(1000)
  gamesPlayed   Int      @default(0) @map("games_played")
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  currentStreak Int      @default(0) @map("current_streak")
  bestStreak    Int      @default(0) @map("best_streak")
  coins         Int      @default(200)
  fcmToken      String?  @map("fcm_token")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  whiteGames    Game[]         @relation("WhitePlayer")
  blackGames    Game[]         @relation("BlackPlayer")
  wonGames      Game[]         @relation("Winner")
  bets          Bet[]
  puzzleAttempts PuzzleAttempt[]
  cosmetics     UserCosmetic[]
  sentFriendRequests     Friendship[]  @relation("FriendRequester")
  receivedFriendRequests Friendship[]  @relation("FriendAddressee")
  notifications Notification[]

  @@index([rating(sort: Desc)])
  @@map("users")
}

model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  addresseeId String   @map("addressee_id") @db.Uuid
  status      String   @default("pending") @db.VarChar(16) // pending | accepted | declined
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  respondedAt DateTime? @map("responded_at") @db.Timestamptz()

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(32) // friend_request | friend_accepted | game_invite | daily_puzzle | system
  payload   String   @default("{}") // JSON payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Game {
  id                String    @id @default(uuid()) @db.Uuid
  whiteUserId       String    @map("white_user_id") @db.Uuid
  blackUserId       String    @map("black_user_id") @db.Uuid
  mode              String    @db.VarChar(10) // ranked | casual
  difficulty        String    @db.VarChar(16) // beginner | intermediate | advanced | master
  timeControl       String    @map("time_control") @db.VarChar(16)
  resultType        String?   @map("result_type") @db.VarChar(20)
  winnerColor       String?   @map("winner_color") @db.VarChar(5)
  winnerUserId      String?   @map("winner_user_id") @db.Uuid
  whiteRatingBefore Int?      @map("white_rating_before")
  blackRatingBefore Int?      @map("black_rating_before")
  whiteRatingAfter  Int?      @map("white_rating_after")
  blackRatingAfter  Int?      @map("black_rating_after")
  moveCount         Int       @default(0) @map("move_count")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt           DateTime? @map("ended_at") @db.Timestamptz()

  whitePlayer User     @relation("WhitePlayer", fields: [whiteUserId], references: [id])
  blackPlayer User     @relation("BlackPlayer", fields: [blackUserId], references: [id])
  winner      User?    @relation("Winner", fields: [winnerUserId], references: [id])
  bets        Bet[]
  moves       GameMove[]

  @@index([whiteUserId])
  @@index([blackUserId])
  @@index([endedAt(sort: Desc)])
  @@map("games")
}

model GameMove {
  id         String   @id @default(uuid()) @db.Uuid
  gameId     String   @map("game_id") @db.Uuid
  moveNumber Int      @map("move_number")
  fen        String   // Position after move
  moveUci    String   @map("move_uci") // UCI notation
  san        String?  // Standard algebraic notation
  cardRank   String?  @map("card_rank") @db.VarChar(2)
  cardSuit   String?  @map("card_suit") @db.VarChar(8)
  color      String   @db.VarChar(5) // white | black
  timestamp  DateTime @default(now()) @db.Timestamptz()

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, moveNumber])
  @@map("game_moves")
}

model Bet {
  id              String   @id @default(uuid()) @db.Uuid
  gameId          String   @map("game_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  amountWei       String   @map("amount_wei") // stored as string for BigInt precision
  amountUsd       Decimal  @map("amount_usd") @db.Decimal(10, 2)
  depositTxHash   String   @map("deposit_tx_hash") @db.VarChar(66)
  payoutTxHash    String?  @map("payout_tx_hash") @db.VarChar(66)
  payoutAmountWei String?  @map("payout_amount_wei")
  status                String   @default("pending") @db.VarChar(24) // pending | confirmed | paid_out | refunded | cancelled | settlement_failed
  settlementRetries     Int      @default(0) @map("settlement_retries")
  lastSettlementError   String?  @map("last_settlement_error") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([gameId])
  @@index([userId])
  @@map("bets")
}

model Puzzle {
  id         String   @id @default(uuid()) @db.Uuid
  fen        String   // Target position FEN
  solution   String   // Best move in UCI notation
  hint       String   // Text hint for player
  difficulty String   @db.VarChar(16) // beginner | intermediate | advanced | master
  category   String   @db.VarChar(24) // daily | tactics | card_management | endgame | weakness
  rating     Int      @default(1500)  // Estimated puzzle rating
  cards      String?  // JSON 3-card hand; contains a card able to play the solution
  isDaily    Boolean  @default(false) @map("is_daily")
  dailyDate  DateTime? @map("daily_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  attempts PuzzleAttempt[]

  @@index([difficulty])
  @@index([category])
  @@index([isDaily, dailyDate])
  @@map("puzzles")
}

model PuzzleAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  puzzleId    String   @map("puzzle_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  solved      Boolean
  attempts    Int      @default(1)
  timeSpentMs Int      @map("time_spent_ms")
  usedHint    Boolean  @default(false) @map("used_hint")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("puzzle_attempts")
}

model Cosmetic {
  id          String         @id @default(uuid()) @db.Uuid
  type        String         @db.VarChar(16) // board | piece | card_back
  name        String         @db.VarChar(64)
  description String?        @db.VarChar(256)
  price       Int            @default(0) // In-game currency
  rarity      String         @default("common") @db.VarChar(16)
  assetUrl    String?        @map("asset_url")
  isDefault   Boolean        @default(false) @map("is_default")
  createdAt   DateTime       @default(now()) @map("created_at")

  owners UserCosmetic[]

  @@map("cosmetics")
}

model UserCosmetic {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  cosmeticId  String   @map("cosmetic_id") @db.Uuid
  equipped    Boolean  @default(false)
  purchasedAt DateTime @default(now()) @map("purchased_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@map("user_cosmetics")
}

model TransactionLog {
  id          String   @id @default(uuid()) @db.Uuid
  gameId      String?  @map("game_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  txType      String   @map("tx_type") @db.VarChar(16) // deposit | payout | refund | house_cut | donation
  txHash      String   @map("tx_hash") @db.VarChar(66)
  amountWei   String   @map("amount_wei")
  chainId     Int      @default(97) @map("chain_id") // 97=BSC testnet, 56=mainnet
  blockNumber BigInt?  @map("block_number")
  status      String   @default("pending") @db.VarChar(16) // pending | confirmed | failed
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("transactions_log")
}

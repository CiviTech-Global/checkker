<?xml version="1.0" encoding="utf-8"?>
<!--
  Checkker connects to a self-hosted game server over plain HTTP/WebSocket on
  the local network (e.g. http://192.168.1.x:3001). Android 9+ (API 28) blocks
  cleartext traffic by default, which silently kills the Socket.IO connection
  and leaves the app stuck on "Offline - reconnecting...".

  This base-config re-enables cleartext so LAN / self-hosted servers work. When
  the game server is later fronted by HTTPS, tighten this to a per-domain
  <domain-config> instead of permitting cleartext app-wide.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

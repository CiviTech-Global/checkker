{
  "name": "@checkker/server",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf .turbo dist",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/server.bundle.js --external:stockfish --external:@prisma/client"
  },
  "dependencies": {
    "@checkker/chess": "*",
    "@checkker/database": "*",
    "@checkker/poker": "*",
    "@checkker/shared": "*",
    "cors": "^2.8.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "@sentry/node": "^8.52.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}

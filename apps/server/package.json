{
  "name": "@checkker/server",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "echo lint ok",
    "clean": "rm -rf .turbo dist",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/server.bundle.js --external:stockfish"
  },
  "dependencies": {
    "@checkker/chess": "*",
    "@checkker/poker": "*",
    "@checkker/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}

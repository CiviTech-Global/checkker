{
  "name": "@checkker/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Checkker desktop app",
  "author": "Checkker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "typecheck": "tsc -p .",
    "lint": "eslint main.js preload.js",
    "clean": "rm -rf dist"
  },
  "build": {
    "appId": "com.checkker.desktop",
    "productName": "Checkker",
    "protocols": [
      {
        "name": "Checkker",
        "schemes": [
          "checkker"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../mobile/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../server/dist/server.bundle.js",
        "to": "server.bundle.js"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Checkker-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "electron": "42.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "^5.8.0"
  }
}
